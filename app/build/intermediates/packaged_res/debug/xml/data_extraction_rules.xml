<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+)
   Defines what data should be included/excluded from backups
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include shared preferences -->
        <include domain="sharedpref" path="."/>
        
        <!-- Exclude specific files that shouldn't be backed up -->
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="temporary/"/>
        <exclude domain="database" path="temp.db"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include shared preferences for device-to-device transfer -->
        <include domain="sharedpref" path="."/>
        
        <!-- Exclude sensitive data -->
        <exclude domain="file" path="credentials/"/>
        <exclude domain="file" path="sensitive/"/>
        <exclude domain="database" path="secure.db"/>
    </device-transfer>
</data-extraction-rules>
